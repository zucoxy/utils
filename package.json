{
  "name": "@unyu/utils",
  "version": "0.1.0",
  "description": "My Commonly used JS/TS utils",
  "author": "unyu <1078119795@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/zucoxy/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zucoxy/utils.git"
  },
  "bugs": {
    "url": "https://github.com/zucoxy/utils/issues"
  },
  "keywords": [
    "utils"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "release": "bumpp --commit --push --tag && npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@unyu/eslint-config": "^3.0.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": "eslint --fix"
  }
}
